          console.log("🔄 Baixando:", zipUrl)

          const r = await fetch(zipUrl)
          if (!r.ok) throw new Error("HTTP " + r.status)
          const buffer = Buffer.from(await r.arrayBuffer())
          fs.writeFileSync(zipPath, buffer)

          // 2. Extrai
          if (!fs.existsSync(extractDir)) fs.mkdirSync(extractDir, { recursive: true })

          try {
            execSync(`unzip -o "${zipPath}" -d "${extractDir}"`, { stdio: "ignore" })
          } catch (_) {
            // Tenta com tar caso não tenha unzip
            try {
              execSync(`tar -xf "${zipPath}" -C "${extractDir}"`, { stdio: "ignore" })
            } catch (e2) {
              throw new Error("Não consegui extrair (falta unzip/tar no servidor)")
            }
          }

          // 3. Acha a pasta extraída (vai ter nome tipo zenitsu-bot-md-main)
          const pastas = fs.readdirSync(extractDir).filter(f => fs.statSync(path.join(extractDir, f)).isDirectory())
