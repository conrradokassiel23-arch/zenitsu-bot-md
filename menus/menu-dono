        await sock.sendMessage(jid, { text: "⚡ Use: *!delaluguel <nome>* ou em grupo só *!delaluguel*" }, { quoted: msg })
      }
    },

    banirgp: {
      aliases: ["bangp", "banirgrupo"],
      async executar({ sock, msg, db }) {
        const jid = msg.key.remoteJid
        const b = db.bangp(); b.grupos = b.grupos || {}; b.grupos[jid] = true; db.salvarBangp(b)
        await sock.sendMessage(jid, { text: "⚡🚫 *TERRITÓRIO BANIDO*\n\n_\"Finge que não viu...\"_" }, { quoted: msg })
      }
    },

    desbanirgp: {
      aliases: ["desbangp"],
      async executar({ sock, msg, db }) {
        const jid = msg.key.remoteJid
        const b = db.bangp()
        if (b.grupos?.[jid]) { delete b.grupos[jid]; db.salvarBangp(b); return sock.sendMessage(jid, { text: "⚡✅ Território liberado!" }, { quoted: msg }) }
        await sock.sendMessage(jid, { text: "⚡ Esse grupo não tá banido!" }, { quoted: msg })
      }
    },

    listabangp: {
      aliases: ["gruposbanidos"],
      async executar({ sock, msg, db }) {
        const jid = msg.key.remoteJid
        const b = db.bangp()
        const grupos = Object.keys(b.grupos || {})
        if (!grupos.length) return sock.sendMessage(jid, { text: "⚡🚫 Nenhum grupo banido!" }, { quoted: msg })
        let txt = "⚡🚫 *BANIDOS*\n\n"
        grupos.forEach((g, i) => { txt += "⚔️ " + (i + 1) + ". " + g + "\n" })
        await sock.sendMessage(jid, { text: txt }, { quoted: msg })
      }
    },

    nuke: {
      aliases: ["explodir", "destruir"],
      async executar({ sock, msg, groupMetadata, utils }) {
        const jid = msg.key.remoteJid
        if (!jid.endsWith("@g.us")) return
        if (!utils.botEhAdmin(groupMetadata, sock)) return sock.sendMessage(jid, { text: "⚡💥 Preciso ser admin!" }, { quoted: msg })
        await sock.sendMessage(jid, { text: "⚡💥 *DEVASTAÇÃO*\n\nExplodindo o território..." }, { quoted: msg })
        const meta = await sock.groupMetadata(jid)
        const botNum = utils.soNumero(sock.user?.id)
        const alvos = meta.participants.filter(p => utils.soNumero(p.id) !== botNum).map(p => p.id)
        for (const a of alvos) {
          try { await sock.groupParticipantsUpdate(jid, [a], "remove") } catch (_) {}
          await new Promise(r => setTimeout(r, 500))
        }
      }
    },

    limpargp: {
      aliases: ["limpargrupo"],
      async executar({ sock, msg, groupMetadata, utils }) {
        const jid = msg.key.remoteJid
        if (!jid.endsWith("@g.us")) return
        if (!utils.botEhAdmin(groupMetadata, sock)) return sock.sendMessage(jid, { text: "⚡🧹 Preciso ser admin!" }, { quoted: msg })
        await sock.sendMessage(jid, { text: "⚡🧹 *LIMPEZA IMPERIAL*\n\nRemovendo membros comuns..." }, { quoted: msg })
        const meta = await sock.groupMetadata(jid)
        const botNum = utils.soNumero(sock.user?.id)
        const alvos = meta.participants.filter(p => {
          if (utils.soNumero(p.id) === botNum) return false
          if (p.admin === "admin" || p.admin === "superadmin") return false
          return true
        }).map(p => p.id)
        for (const a of alvos) {
          try { await sock.groupParticipantsUpdate(jid, [a], "remove") } catch (_) {}
          await new Promise(r => setTimeout(r, 500))
        }
      }
    }

  }
}
