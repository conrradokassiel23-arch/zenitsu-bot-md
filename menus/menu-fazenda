          const estrelas = q >= 90 ? "🎩⭐⭐" : q >= 70 ? "⭐⭐" : q >= 50 ? "⭐" : ""
          const status = p.pronta ? "✅ Pronta!" : `⏰ Crescendo...`
          txt += `🎩 ${p.emoji} *${p.nome}*\n   ${status}\n   📊 ${q}% ${estrelas}\n   💧 Regas: ${p.regas || 0}\n\n`
        }
        await sock.sendMessage(jid, { text: txt, mentions: [sender] }, { quoted: msg })
      }
    }

  }
}
